<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_product_account_payable"
              inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_subtotal']" position="before">
            <th name="th_product_account_payable"
                t-if="o.is_purchase_document(include_receipts=True)"
                t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Account Payable</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='td_subtotal']" position="after">
            <td t-if="is_product and o.is_purchase_document(include_receipts=True)"
                name="account_invoice_line_product_account_payable"
                t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span t-field="line.product_account_payable_id"/>
            </td>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="after">
            <t t-if="o.is_purchase_document(include_receipts=True)">
                <t t-set="account_payable_summary" t-value="o._get_product_account_payable_summary_for_report()"/>
                <t t-if="len(account_payable_summary) &gt; 1">
                    <div class="mt-3">
                        <strong>Account Payable Summary</strong>
                        <table class="table table-sm table-borderless mb-0">
                            <thead>
                                <tr>
                                    <th class="text-start">Account</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="account_payable_summary" t-as="account_payable_row">
                                    <td class="text-start">
                                        <span t-esc="account_payable_row['account_code']"/>
                                        <span t-if="account_payable_row['account_name']"> - </span>
                                        <span t-esc="account_payable_row['account_name']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="account_payable_row['amount_formatted']"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </xpath>
    </template>
</odoo>
