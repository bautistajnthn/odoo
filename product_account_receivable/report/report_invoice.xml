<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_product_account_receivable"
              inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_subtotal']" position="before">
            <th name="th_product_account_receivable"
                t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span>Account Receivable</span>
            </th>
        </xpath>
        <xpath expr="//td[@name='td_subtotal']" position="after">
            <td t-if="is_product"
                name="account_invoice_line_product_account_receivable"
                t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                <span t-field="line.product_account_receivable_id"/>
            </td>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="after">
            <t t-set="account_receivable_summary" t-value="o._get_product_account_receivable_summary_for_report()"/>
            <t t-if="len(account_receivable_summary) &gt; 1">
                <div class="mt-3">
                    <strong>Account Receivable Summary</strong>
                    <table class="table table-sm table-borderless mb-0">
                        <thead>
                            <tr>
                                <th class="text-start">Account</th>
                                <th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="account_receivable_summary" t-as="account_receivable_row">
                                <td class="text-start">
                                    <span t-esc="account_receivable_row['account_code']"/>
                                    <span t-if="account_receivable_row['account_name']"> - </span>
                                    <span t-esc="account_receivable_row['account_name']"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="account_receivable_row['amount_formatted']"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
